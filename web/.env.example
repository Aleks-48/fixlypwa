# ─────────────────────────────────────────────────────────────────────────────
# Пример окружения. Скопируй в .env и подставь реальные секреты (.env вне репо, NFR-053).
# Значения ниже — безопасные локальные дефолты для `docker compose up` на своей машине.
# Для продакшна замени ВСЕ пароли на сильные секреты.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (суперпользователь; используется миграциями и как владелец БД) ──
POSTGRES_DB=fixlypwa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Пароли ролей приложения (ADR-0006) ──
# app_login — обычная роль, ПОД RLS; из неё работает весь рантайм приложения.
# app_superadmin — роль BYPASSRLS для явных кросс-тенантных админ-путей (обращаться как с
# суперпользователем). Роли создаёт RLS-миграция с плейсхолдером, db-bootstrap ставит эти пароли.
APP_DB_PASSWORD=app_pass
APP_SUPERADMIN_PASSWORD=superadmin_pass

# ── Подключения Prisma ──
# DATABASE_URL — рантайм приложения. ОБЯЗАТЕЛЬНО роль app_login (не postgres!): суперпользователь
# обходит RLS, и изоляция тенантов перестанет работать.
#   • локальный dev без PgBouncer  → прямое подключение app_login к Postgres (RLS всё равно действует):
#       postgresql://app_login:app_pass@localhost:5544/fixlypwa?schema=public
#   • полный стек через PgBouncer   → добавь pgbouncer=true (transaction pooling):
#       postgresql://app_login:app_pass@localhost:6432/fixlypwa?pgbouncer=true&schema=public
DATABASE_URL="postgresql://app_login:app_pass@localhost:5544/fixlypwa?schema=public"

# DIRECT_URL — прямое подключение суперпользователя для `prisma migrate` (в обход PgBouncer).
DIRECT_URL="postgresql://postgres:postgres@localhost:5544/fixlypwa?schema=public"

# ── Auth / сессии (ADR-0005) ──
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# console — dev-заглушка (OTP в лог сервера); mobizon — реальный шлюз (Q-030 решён — Mobizon.kz,
# общая подпись отправителя, юрлицо/альфа-имя не нужны). MOBIZON_API_KEY — из личного кабинета.
SMS_PROVIDER=console
# MOBIZON_API_KEY=
# Telegram-канал OTP для телефона (REQ-009, telegram-otp.md) — временная замена SMS-шлюза,
# пока не оформлено ИП/юрлицо (Q-030). sms — текущее поведение (дефолт); telegram — телефон
# идёт через бота (нужна привязка TelegramLink через кнопку «Поделиться номером»).
PHONE_OTP_CHANNEL=sms
TELEGRAM_PROVIDER=console
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Публичная копия TELEGRAM_BOT_USERNAME — постоянная ссылка на бота в login/register (не
# только реактивно на шаге needsTelegramLink). Не секрет, username бота публичен.
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# Почтовый канал OTP (auth-email.md, REQ-006): console — dev-заглушка (код в лог);
# smtp — реальная отправка (SMTP_* и MAIL_FROM обязательны). Для прода: транзакционный
# сервис (Resend/Brevo/…), домен с SPF/DKIM/DMARC — иначе письма уйдут в спам.
EMAIL_PROVIDER=console
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxx
# MAIL_FROM="Fixly <no-reply@fixly.kz>"
# Эхо OTP-кода в API-ответе/UI (подсказка «код для входа»). Секьюрный дефолт — 0.
# Локально для демо можно поставить 1. ⚠️ В ПРОДЕ ТОЛЬКО 0: с 1 любой может запросить
# код чужого номера и увидеть его в ответе (захват аккаунта). Без эха код виден в логе app.
OTP_DEV_ECHO=0

# ── AI-ассистент (срез 30, docs/specs/ai-assistant.md) ──
# 'console' — dev-заглушка (без реального вызова, ответ детерминирован); 'groq' — MVP-дефолт
# (бесплатный тариф, groq.com); 'claude' — резерв на случай проблем с качеством/лимитами Groq.
# Смена провайдера НЕ снимает вопрос трансграничной передачи данных (§6.3 спеки) — он одинаково
# открыт для Groq и Claude.
LLM_PROVIDER=console
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Лимиты сообщений ассистента (REQ-160) — защита от злоупотребления.
ASSISTANT_MAX_MESSAGES_PER_DAY_USER=30
ASSISTANT_MAX_MESSAGES_PER_DAY_OSI=300

# ── Web Push (срез 7, опционально) ──
# Без ключей push отключён (in-app центр уведомлений работает всегда).
# Генерация пары ключей: npx web-push generate-vapid-keys
# ⚠️ Payload push не должен содержать ПДн (REQ-105) — это обеспечивает код, ключи только транспорт.
WEB_PUSH_EMAIL=
WEB_PUSH_PRIVATE_KEY=
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=

# ── CORS для dev-теста Flutter WEB-сборки (src/middleware.ts, срез 21) ──
# Нативному приложению не нужен. Список origin через запятую. ⚠️ В ПРОДЕ НЕ ЗАДАВАТЬ.
CORS_DEV_ORIGINS=

# ── FCM для мобильного клиента (ADR-0012 §5, срез 20, опционально) ──
# Параллельный push-канал к Web Push — без ключей отключён (Web Push и in-app центр работают).
# Сервисный аккаунт Firebase: Project Settings → Service accounts → Generate new private key.
# FIREBASE_PRIVATE_KEY — вставить значение поля private_key из JSON как есть (с \n внутри).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Гос-интеграции (опционально; см. docs/specs/gov-integrations.md) ──
# Aitu Passport (Digital ID): партнёрские ключи выдаёт BTS Digital по договору.
# Без ключей кнопка «Войти через Aitu» скрыта; OAuth-адаптер готов (src/lib/gov/aitu.ts).
AITU_CLIENT_ID=
AITU_CLIENT_SECRET=
AITU_BASE_URL=
# Smart Bridge (sb.egov.kz): сервис-ключ после договора; без него — заглушка NOT_CONFIGURED.
SMARTBRIDGE_SERVICE_KEY=

# ── Демо-житель для scripts/seed-demo.ts (review 2026-07-22, опционально) ──
# Реальный номер, уже привязанный к Telegram-боту (/start + «Поделиться номером») — сид
# восстанавливает эту привязку при каждом запуске, чтобы не проходить бота заново после
# docker compose down -v. Без этих переменных резидент сидится с fake-номером +77010000001
# без Telegram-привязки (личные данные конкретного человека — не хардкодим в репозитории).
SEED_RESIDENT_PHONE=
SEED_RESIDENT_TG_CHAT=
