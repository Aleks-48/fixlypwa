enum AuditEntityType {
  CHARGE
  PAYMENT
  TARIFF
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// Append-only журнал финансовых мутаций — снимает споры «куда ушли деньги» (vision.md §3).
/// Приложение никогда не делает UPDATE/DELETE над этой таблицей.
model AuditLog {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId       String          @map("osi_id") @db.Uuid
  entityType  AuditEntityType @map("entity_type")
  entityId    String          @map("entity_id") @db.Uuid
  action      AuditAction
  diff        Json?
  actorUserId String          @map("actor_user_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([osiId])
  @@index([entityType, entityId])
  @@map("audit_log")
}

/// Журнал действий админки платформы (ADR-0008, REQ-110) — identity-таблица ВНЕ RLS
/// (действия суперадмина платформенные: у смены статуса мастера osiId нет в принципе).
/// Append-only: приложение никогда не делает UPDATE/DELETE. НЕ смешивать с финансовым
/// AuditLog ОСИ (тот — тенантный журнал споров о деньгах). Секреты (пароли) в diff не пишутся.
model AdminAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  /// Код действия: MASTER_STATUS | SUBSCRIPTION_SET | CHAIRMAN_GRANT | PASSWORD_RESET | …
  action      String
  /// Идентификатор затронутой сущности (uuid мастера/дома/пользователя — тип зависит от action).
  entityId    String   @map("entity_id")
  diff        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([action, entityId])
  @@map("admin_audit_log")
}

