enum RequestCategory {
  PLUMBING
  ELEVATOR
  CLEANING
  ELECTRICITY
  OTHER
}

enum RequestStatus {
  RECEIVED
  IN_PROGRESS
  RESOLVED
}

/// Заявка жителя — снижает нагрузку председателя (features.md принцип 3), официальный след
/// вместо потерянного сообщения в WhatsApp.
model Request {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId        String          @map("osi_id") @db.Uuid
  buildingId   String          @map("building_id") @db.Uuid
  apartmentId  String?         @map("apartment_id") @db.Uuid
  authorUserId String          @map("author_user_id") @db.Uuid
  /// Назначенный мастер (необязательно) — председатель назначает из списка проверенных мастеров
  masterId     String?         @map("master_id") @db.Uuid
  category     RequestCategory
  text         String
  photoUrls    String[]        @map("photo_urls")
  status       RequestStatus   @default(RECEIVED)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  building      Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  apartment     Apartment?       @relation(fields: [apartmentId], references: [id])
  master        Master?          @relation("RequestMaster", fields: [masterId], references: [id], onDelete: SetNull)
  messages      RequestMessage[]
  marketListing MarketListing?
  reviews       MasterReview[]

  @@index([osiId])
  @@index([buildingId])
  @@index([status])
  @@index([masterId])
  @@map("request")
}

model RequestMessage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId        String   @map("osi_id") @db.Uuid // денормализовано с Request — ADR-0006: каждая tenant-таблица несёт osiId для RLS
  requestId    String   @map("request_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  text         String
  /// Вложения мобильного клиента (mobile-app.md §4, срез 22) — ссылки на уже загруженные через
  /// /api/uploads файлы (REQ-131, приватные, не публичный storage). Оба опциональны, text
  /// остаётся обязательным (аудио/фото дополняют сообщение, не заменяют).
  audioUrl     String?  @map("audio_url")
  imageUrl     String?  @map("image_url")
  createdAt    DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([requestId])
  @@map("request_message")
}

// ---- Маркетплейс заявок — мастера (ADR-0009, docs/specs/marketplace.md) ----
// MarketListing/MarketOffer — tenant-таблицы (несут osiId), НО с ДВУМЯ RLS-политиками
// (permissive, объединяются через OR): tenant_iso — путь председателя через forTenant();
// market_read/master_own — путь мастера через forMaster() (см. RLS-миграцию). Обычный
// generic-цикл RLS-политик (prisma/migrations/.../rls_policies) на них НЕ применяется —
// политики этих двух таблиц описаны отдельно.

enum MarketListingStatus {
  PUBLISHED // видна проверенным (APPROVED) мастерам своего города
  TAKEN // отклик принят, снята с общей витрины
  CLOSED // председатель снял публикацию / заявка закрыта
}

/// Витрина-проекция заявки для мастеров (ADR-0009, вариант C: НЕ JOIN к Request, а явная
/// копия whitelist-полей). НИКОГДА не копировать: квартиру, ФИО/телефон жителя, тред заявки —
/// это гарантия приватности до принятия отклика (marketplace.md §4).
model MarketListing {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId         String              @map("osi_id") @db.Uuid
  requestId     String              @unique @map("request_id") @db.Uuid
  city          String
  category      RequestCategory
  title         String
  description   String
  photoUrls     String[]            @map("photo_urls")
  buildingLabel String              @map("building_label") // адрес дома БЕЗ номера квартиры
  status        MarketListingStatus @default(PUBLISHED)
  publishedAt   DateTime            @default(now()) @map("published_at")
  closedAt      DateTime?           @map("closed_at")

  request Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offers  MarketOffer[]

  @@index([osiId])
  @@index([city, status])
  @@map("market_listing")
}

enum MarketOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// Отклик мастера на листинг. osiId денормализован с MarketListing — как и везде в схеме,
/// каждая tenant-таблица несёт свой osiId для RLS (ADR-0006), даже если он выводим через JOIN.
model MarketOffer {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId     String            @map("osi_id") @db.Uuid
  listingId String            @map("listing_id") @db.Uuid
  masterId  String            @map("master_id") @db.Uuid
  message   String
  price     Decimal?          @db.Decimal(12, 2)
  status    MarketOfferStatus @default(OFFERED)
  createdAt DateTime          @default(now()) @map("created_at")

  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  master  Master        @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([listingId, masterId]) // один мастер — один активный отклик на листинг
  @@index([osiId])
  @@index([listingId])
  @@index([masterId])
  @@map("market_offer")
}

