}

enum NotificationType {
  ANNOUNCEMENT
  REQUEST_CREATED
  REQUEST_STATUS
  REQUEST_MESSAGE
  CHARGE_CREATED // REQ-106: массовая генерация начислений → жителям квартиры
  OSI_JOIN_REQUEST // REQ-152: житель отправил заявку на подключение к ОСИ
}

/// In-app уведомление (срез 7, REQ-100/101). Tenant-таблица — ПОД RLS (несёт osiId).
/// userId — получатель. entityType/entityId — deep link на источник (объявление/заявку).
/// Web Push доставляет только тип+id (REQ-105), а этот текст показывается в приложении.
model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId      String           @map("osi_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String
  body       String
  entityType String?          @map("entity_type") // 'announcement' | 'request'
  entityId   String?          @map("entity_id") @db.Uuid
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([userId, readAt])
  @@map("notification")
}

// =====================================================================================
// AI-АССИСТЕНТ (срез 30, docs/specs/ai-assistant.md) — read-only tool use поверх сервисов
// выше + история диалога. Провайдер (Groq/Claude) выбирается через LLM_PROVIDER (env.ts) —
// содержимое ниже провайдер-агностично.
// =====================================================================================

enum AssistantRole {
  USER
  ASSISTANT
}

/// Диалог с ассистентом. Tenant-таблица ПОД RLS. ⚠️ content сообщений (ниже) хранится ТОЛЬКО
/// в псевдонимизированном виде (ФИО/телефоны/ИИН заменены до записи, §6 спеки) — pseudonymMap
/// это словарь для де-подстановки ПРИ РЕНДЕРЕ клиенту, он не отправляется во внешний LLM.
model AssistantConversation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId        String   @map("osi_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  title        String?
  pseudonymMap Json     @default("{}") @map("pseudonym_map")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([osiId, userId])
  @@map("assistant_conversation")
}

/// Одно сообщение диалога — content уже псевдонимизирован (см. AssistantConversation).
/// toolCalls — только имена/аргументы вызовов (аудит), НЕ результаты (те не хранятся отдельно,
/// они уже вошли в текст ответа модели).
model AssistantMessage {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId          String        @map("osi_id") @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AssistantRole
  content        String
  toolCalls      Json?         @map("tool_calls")
  tokensIn       Int?          @map("tokens_in")
  tokensOut      Int?          @map("tokens_out")
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([conversationId])
  @@map("assistant_message")
}

// =====================================================================================
// ГОЛОСОВАНИЯ — быстрые опросы (Фаза 1, lite, НЕ юридически значимые) и легитимные собрания
// (Фаза 3, Тир 2 — за регуляторным барьером аккредитации, ADR-0007). Meeting/MeetingVote —
// заготовка по domain-model.md, реализация отложена до партнёрства (Q-039/Q-043).
// =====================================================================================

model Poll {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId      String    @map("osi_id") @db.Uuid
  buildingId String    @map("building_id") @db.Uuid
  question   String
  deadline   DateTime?
  createdAt  DateTime  @default(now()) @map("created_at")

  building Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  options  PollOption[]
  Document Document[]

  @@index([osiId])
  @@index([buildingId])
  @@map("poll")
}

model PollOption {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId  String @map("osi_id") @db.Uuid
  pollId String @map("poll_id") @db.Uuid
  label  String

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([osiId])
  @@map("poll_option")
}

/// Неформальное голосование (lite) — не юридически значимое, 1 голос на пользователя.
model Vote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId     String   @map("osi_id") @db.Uuid
  optionId  String   @map("option_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  User   User       @relation(fields: [userId], references: [id])

  @@unique([optionId, userId])
  @@index([osiId])
  @@map("vote")
}

enum MeetingStatus {
  DRAFT
  IN_PROGRESS
  CLOSED
}

/// Легитимное собрание (Приложение 1 к приказу № 163) — Тир 2, за барьером аккредитации.
/// Заготовка схемы; реализация flow (кворум, идентификация, ЭЦП-протокол) — Фаза 3, ADR-0007.
model Meeting {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId             String        @map("osi_id") @db.Uuid
  buildingId        String        @map("building_id") @db.Uuid
  agenda            String
  quorumRequirement String?       @map("quorum_requirement") // >50% участников либо от общего числа — п.11/12 приказа №163
  status            MeetingStatus @default(DRAFT)
  protocolUrl       String?       @map("protocol_url")

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([buildingId])
  @@map("meeting")
}

// ---- Настройки уведомлений (settings.md §1.2, REQ-048) ----

/// Гранулярные тумблеры push-категорий для пары (пользователь × ОСИ).
/// Хранится под RLS: пользователь видит/редактирует только свои строки внутри ОСИ.
/// Запись создаётся при первом обращении (upsert), дефолты — всё включено.
model NotificationPreference {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId          String   @map("osi_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// Объявления дома (NotificationType.ANNOUNCEMENT)
  announcements  Boolean  @default(true)
  /// Изменения статуса заявок (NotificationType.REQUEST_*)
  requestUpdates Boolean  @default(true) @map("request_updates")
  /// Новые начисления (NotificationType.CHARGE_CREATED)
  charges        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([osiId, userId])
  @@index([osiId])
  @@map("notification_preference")
}

