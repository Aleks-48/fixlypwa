  chairmanName     String?      @map("chairman_name")
  houseCouncilName String?      @map("house_council_name")
  fileUrl          String?      @map("file_url") // Q-013 остаток: формат вывода PDF/веб
  /// Снимок цифр отчёта на момент генерации (4 блока формы) — опубликованный отчёт не «плывёт»
