// Единый источник модели данных проекта (CLAUDE.md).
// Домен описан на языке предметной области в docs/specs/domain-model.md — этот файл его
// техническая реализация. Мультитенантность — Postgres RLS по osiId (ADR-0006, паттерн
// подтверждён спайком spikes/rls-prisma/). RLS-политики добавляются raw-SQL поверх миграции,
// сгенерированной из этой схемы (см. prisma/migrations/.../migration.sql).
//
// Тир 1 (Фазы 1–2, features.md) — то, что в этой схеме. Тир 2 (легитимные голосования Meeting,
// госверификация) — заготовки минимальны, реализация за ADR-0007 (партнёрство).

generator client {
  provider      = "prisma-client-js"
  // native — для локальной разработки; debian — для Docker-образа (node:bookworm-slim).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // url — рантайм-подключение приложения через PgBouncer (transaction pooling, app_login).
  // directUrl — прямое подключение суперпользователя для миграций/интроспекции (в обход
  // PgBouncer): prisma migrate требует не-pooled соединения (ADR-0006, спайк). Если DIRECT_URL
  // не задан, Prisma использует url.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================================================
// IDENTITY — вне RLS (bootstrapping, ADR-0006 ревизия): сессия → пользователь → его Osi
// отрабатывает ДО того, как известен osi_id, поэтому эти таблицы не могут быть под RLS.
// =====================================================================================

/// Объединение собственников имущества — единица тенанта (Q-005). Сама Osi тоже вне RLS:
/// доступ к строкам Osi контролируется через UserOsiRole (пользователь видит только свои Osi
/// на уровне приложения/API), а не через RLS-политику на osi_id (это же ключ тенанта).
model Osi {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  bin          String?   @unique @db.VarChar(12) // БИН — [TBD] точный формат
  address      String?
  registeredAt DateTime? @map("registered_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  roles        UserOsiRole[]
  buildings    Building[]
  joinRequests OsiJoinRequest[] // заявки на подключение к ОСИ (REQ-151)

  @@map("osi")
}

enum JoinRequestStatus {
  PENDING
  RESOLVED
}

/// Заявка жителя на подключение к ОСИ (REQ-151..154, docs/specs/osi-join-request.md) —
/// identity-таблица, ВНЕ RLS: создаётся ДО того, как у пользователя есть роль/osiId-контекст
/// в этой ОСИ (тот же принцип, что TelegramLink/UserOsiRole). Председатель читает её вручную
/// фильтруя по своей osiId (паттерн chairmenOfOsi() в notifications/service.ts) — привязку
/// к квартире заявка НЕ делает сама, только уведомляет; председатель по-прежнему подключает
/// через AddResidentForm (поиск по телефону/email, REQ-013).
model OsiJoinRequest {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId      String            @map("osi_id") @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  /// Свободный текст жителя (дом/квартира/подъезд) — не Apartment: председатель верифицирует
  /// и привязывает к реальной квартире сам, заявка — только контекст для него.
  note       String?
  status     JoinRequestStatus @default(PENDING)
  createdAt  DateTime          @default(now()) @map("created_at")
  resolvedAt DateTime?         @map("resolved_at")

  osi  Osi  @relation(fields: [osiId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, osiId])
  @@index([osiId, status])
  @@map("osi_join_request")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone        String?  @unique
  email        String?  @unique
  fullName     String?  @map("full_name")
  language     String   @default("ru") @db.VarChar(5)
  passwordHash String?  @map("password_hash")
  isSuperadmin Boolean  @default(false) @map("is_superadmin")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions               Session[]
  roles                  UserOsiRole[]
  occupant               Occupant?
  pushSubscriptions      PushSubscription[]
  notifications          Notification[]
  master                 Master?
  votes                  Vote[]
  OsiJoinRequest         OsiJoinRequest[]
  FcmToken               FcmToken[]
  AssistantConversation  AssistantConversation[]
  NotificationPreference NotificationPreference[]
  reviews                MasterReview[]
  documentReads          DocumentRead[]
  ikomekComplaints       IKomekComplaint[]

  @@map("users")
}

/// Web Push подписка устройства (срез 7, REQ-102). Identity-таблица — ВНЕ RLS: подписка
/// принадлежит устройству пользователя, не ОСИ. Мёртвые подписки (404/410) удаляются
/// приложением (REQ-103). Ключи p256dh/auth — параметры шифрования payload по стандарту Web Push.
model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

/// FCM-токен нативного клиента (ADR-0012 §5, REQ-127) — параллельный push-канал: PushSubscription
/// = Web Push/VAPID (сайт), FcmToken = Firebase Cloud Messaging (Flutter). Разные протоколы,
/// разные таблицы. Identity — ВНЕ RLS, как PushSubscription (устройство, не тенант). Мёртвые
/// токены (UNREGISTERED/INVALID_ARGUMENT от Firebase) удаляются приложением (REQ-130).
model FcmToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_token")
}

/// Канал доставки одноразового кода (auth-email.md, REQ-005/006): следует из типа
/// идентификатора (email → EMAIL, телефон → SMS или TELEGRAM). TELEGRAM — REQ-009,
/// временная замена SMS-шлюза (PHONE_OTP_CHANNEL=telegram), пользователь канал не выбирает —
/// он определяется типом идентификатора и конфигурацией сервера.
enum OtpChannel {
  SMS
  EMAIL
  TELEGRAM
}

/// Привязка телефона к чату Telegram-бота (REQ-009, telegram-otp.md) — identity, ВНЕ RLS
/// (нужна ДО того, как известен osi_id/User). Привязка происходит ТОЛЬКО через кнопку
/// «Поделиться номером» бота (Bot API request_contact — физически не может передать чужой
/// номер), поэтому здесь нет подписанного токена/nonce — сама природа записи уже доказывает
/// владение телефоном на момент создания.
model TelegramLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @unique
  chatId    String   @map("chat_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("telegram_link")
}

/// Челлендж OTP-входа (ADR-0005 + ревизия 2026-07-15, REQ-005/006/091, NFR-054).
/// Identity-таблица — ВНЕ RLS (нужна ДО того, как известен osi_id). identifier —
/// нормализованный телефон или email в lowercase. Хранит хеш кода (не сам код), TTL и
/// счётчик попыток; requestIp — для rate-limit по IP. Служит и rate-limit-журналом: свежие
/// записи по identifier/ip в окне ограничивают частоту запросов (SMS платные — защита от
/// SMS-pumping; для email — защита от спама с нашего домена).
model TelegramUpdateReceipt {
  id          Int      @id
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("telegram_update_receipt")
}

model OtpChallenge {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  channel    OtpChannel @default(SMS)
  codeHash   String     @map("code_hash") // sha256(identifier:code) — код в открытом виде не хранится
  requestIp  String?    @map("request_ip")
  attempts   Int        @default(0) // попытки ввода кода — при превышении челлендж сгорает
  consumedAt DateTime?  @map("consumed_at") // успешно использован — одноразовость
  expiresAt  DateTime   @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([identifier])
  @@index([createdAt])
  @@map("otp_challenge")
}

/// Самописные сессии по паттерну Lucia (ADR-0005, ревизия — пакет `lucia` не используется).
/// id — hash токена (не хранить токен в открытом виде). activeOsiId — текущий рабочий
/// контекст председателя (user-roles.md §3): какая Osi активна, определяет RLS-контекст
/// запроса через forTenant(activeOsiId, ...).
model Session {
  id          String   @id // sha256-hash токена сессии
  userId      String   @map("user_id") @db.Uuid
  activeOsiId String?  @map("active_osi_id") @db.Uuid
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum Role {
  SUPERADMIN
  CHAIRMAN
  RESIDENT
  // ACCOUNTANT — вне MVP (Q-016 закрыт), зарезервировано в модели прав, не как отдельная роль здесь
}

/// User ↔ Osi многие-ко-многим (Q-011): председатель может состоять в нескольких Osi.
model UserOsiRole {
  userId String @map("user_id") @db.Uuid
  osiId  String @map("osi_id") @db.Uuid
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  osi  Osi  @relation(fields: [osiId], references: [id], onDelete: Cascade)

  @@id([userId, osiId])
  @@map("user_osi_role")
}

enum MasterStatus {
  PENDING // анкета подана, ждёт ручного одобрения (Q-053, до появления админки)
  APPROVED // видит витрину заказов своего города
  REJECTED
  BLOCKED
}

/// Мастер маркетплейса заявок (ADR-0009, docs/specs/marketplace.md) — identity-таблица,
/// ВНЕ RLS: мастер не участник ни одной ОСИ, у него нет osiId/tenant-контекста. Доступ к
/// витрине даёт ОТДЕЛЬНЫЙ контекст forMaster() (city), не forTenant(). Один User — максимум
/// один Master (1:1): роль "мастер" не пересекается с ролями UserOsiRole.
model Master {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String            @unique @map("user_id") @db.Uuid
  fullName     String            @map("full_name")
  city         String
  categories   RequestCategory[]
  bio          String?
  status       MasterStatus      @default(PENDING)
  /// Кэшированный средний рейтинг (пересчитывается при добавлении отзыва)
  rating         Float             @default(0.0)
  /// Кол-во отзывов (денормализация для быстрого отображения)
  reviewsCount   Int               @default(0) @map("reviews_count")
  /// Комиссия маркетплейса (по умолчанию 3% = 0.030)
  commissionRate Decimal           @default(0.030) @map("commission_rate") @db.Decimal(4, 3)
  /// Географические координаты местоположения мастера на карте
  lat            Float?
  lng            Float?
  createdAt      DateTime          @default(now()) @map("created_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers       MarketOffer[]
  portfolio    MasterPortfolioItem[]
  reviews      MasterReview[]
  assignedReqs Request[]             @relation("RequestMaster")

  @@index([city, status])
  @@map("master")
}

/// Портфолио выполненных работ мастера (docs/specs/masters-map.md, REQ-073)
/// Identity-слой (вне RLS), так как мастер не привязан к ОСИ.
model MasterPortfolioItem {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  masterId    String          @map("master_id") @db.Uuid
  title       String
  description String?
  category    RequestCategory
  photoUrls   String[]        @map("photo_urls")
  createdAt   DateTime        @default(now()) @map("created_at")

  master Master @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([masterId])
  @@map("master_portfolio_item")
}

/// Отзыв о работе мастера маркетплейса. Identity-слой (вне RLS).
model MasterReview {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Preserve legacy tenant/author metadata; new reviews always provide both.
  osiId        String?  @map("osi_id") @db.Uuid
  masterId     String   @map("master_id") @db.Uuid
  authorUserId String?  @map("author_user_id") @db.Uuid
  requestId    String?  @map("request_id") @db.Uuid
  rating       Int
  comment      String?
  photoUrls    String[] @default([]) @map("photo_urls")
  createdAt    DateTime @default(now()) @map("created_at")

  master  Master   @relation(fields: [masterId], references: [id], onDelete: Cascade)
  author  User?    @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  request Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([masterId])
  @@index([authorUserId])
  @@map("master_review")
}

// =====================================================================================
// TENANT — под RLS. Каждая модель несёт osiId (ADR-0006). Доступ только через forTenant().
// =====================================================================================

model Building {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId           String @map("osi_id") @db.Uuid
  address         String
  /// Структурированный город (ADR-0009: маркетплейс мастеров матчит по городу, не по
  /// свободному адресу). Дефолт — бэкфилл существующих домов, менять по мере роста за Кокшетау.
  city            String @default("Кокшетау")
  apartmentsCount Int?   @map("apartments_count")
  builtYear       Int?   @map("built_year") // [TBD]

  // Osi вне RLS (identity) — эта связь не участвует в forTenant()-паттерне, только для чтения
  // связанных данных приложением (напр. отображение названия ОСИ рядом с домом).
  osi           Osi            @relation(fields: [osiId], references: [id])
  apartments    Apartment[]
  tariffs       Tariff[]
  reports       Report[]
  subscription  Subscription?
  bankAccounts  BankAccount[]
  expenses      Expense[]
  announcements Announcement[]
  requests      Request[]
  infoItems     InfoItem[]
  polls         Poll[]
  meetings      Meeting[]
  documents        Document[]
  ikomekComplaints IKomekComplaint[]

  @@index([osiId])
  @@map("building")
}

// Тип помещения (REQ-011 ревизия 2026-07-18, Q-063, excel-import.md §5) — для будущей
// сверки с IncomeCategory (квартиры/нежилые vs парковки/кладовки, report-spec.md §2а).
// Опционально: существующие помещения без указания типа остаются NULL, обратной силы нет.
enum ApartmentType {
  RESIDENTIAL
  NON_RESIDENTIAL
  PARKING
  STORAGE
}

/// Единица собственности в доме (REQ-011).
model Apartment {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId      String         @map("osi_id") @db.Uuid
  buildingId String         @map("building_id") @db.Uuid
  number     String
  area       Decimal?       @db.Decimal(8, 2) // м²
  rooms      Int?           // Кол-во комнат
  type       ApartmentType?

  building         Building          @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  account          Account?
  owners           Owner[]
  occupants        Occupant[]
  requests         Request[]
  ikomekComplaints IKomekComplaint[]

  @@index([osiId])
  @@index([buildingId])
  @@map("apartment")
}

/// Лицевой счёт — учётная единица начислений (Q-006: 1 квартира = 1 Account).
model Account {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId         String  @map("osi_id") @db.Uuid
  apartmentId   String  @unique @map("apartment_id") @db.Uuid
  accountNumber String? @map("account_number")

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  charges   Charge[]
  payments  Payment[]

  @@index([osiId])
  @@map("account")
}

/// Собственник — юридическое владение (Q-007), может отличаться от Occupant.
/// userId опционален: не у каждого Owner обязательно есть логин.
model Owner {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId          String   @map("osi_id") @db.Uuid
  apartmentId    String   @map("apartment_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  fullName       String   @map("full_name")
  phone          String?
  iin            String? // ПДн — NFR-051, хранить только на инфраструктуре в РК
  ownershipShare Decimal? @map("ownership_share") @db.Decimal(5, 4) // доля владения, [TBD]

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([apartmentId])
  @@map("owner")
}

/// Проживающий — фактический пользователь кабинета (Q-007). userId обязателен (это и есть
/// основной пользователь кабинета жителя, REQ-052). Может не совпадать с Owner —
/// видит данные Account/Apartment целиком (Q-033 закрыт, domain-model.md).
/// phone опционален с ревизии REQ-013 (auth-email.md §4): жителя можно пригласить по email.
model Occupant {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId       String  @map("osi_id") @db.Uuid
  apartmentId String  @map("apartment_id") @db.Uuid
  userId      String  @unique @map("user_id") @db.Uuid
  fullName    String  @map("full_name")
  phone       String?

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([apartmentId])
  @@map("occupant")
}

/// Статья тарифа — минимум 3 (Q-008): эксплуатация, целевой сбор, кап.ремонт.
/// Совпадает с бакетами задолженности (REQ-024, Q-032) и группировкой IncomeCategory ниже.
enum TariffCategory {
  MAINTENANCE // эксплуатационные расходы / управление объектом кондоминиума
  TARGETED // целевой сбор
  CAPITAL_REPAIR // накопления на капитальный ремонт (обособленный фонд)
}

enum RateType {
  PER_SQM
  FIXED
}

model Tariff {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId      String         @map("osi_id") @db.Uuid
  buildingId String         @map("building_id") @db.Uuid
  category   TariffCategory
  rateType   RateType       @map("rate_type")
  rate       Decimal        @db.Decimal(12, 2)
  periodFrom DateTime       @map("period_from")
  periodTo   DateTime?      @map("period_to")

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  charges  Charge[]

  @@index([osiId])
  @@index([buildingId])
  @@map("tariff")
}

/// Статус ОПЛАТЫ начисления — 3 значения (REQ-023, пересмотрено при ревизии).
/// "Просрочено" НЕ хранится: это computed-признак (dueDate в прошлом И status != PAID),
/// вычисляется в запросе/приложении, а не в БД — статус оплаты и просрочка ортогональны.
enum ChargeStatus {
  OPEN
  PARTIALLY_PAID
  PAID
}

model Charge {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId     String       @map("osi_id") @db.Uuid
  accountId String       @map("account_id") @db.Uuid
  tariffId  String       @map("tariff_id") @db.Uuid
  period    DateTime // месяц начисления
  amount    Decimal      @db.Decimal(12, 2)
  dueDate   DateTime     @map("due_date")
  status    ChargeStatus @default(OPEN)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tariff  Tariff  @relation(fields: [tariffId], references: [id])

  @@index([osiId])
  @@index([accountId])
  @@map("charge")
}

/// Категория поступления — строки 6.1–6.7 формы отчёта (report-spec.md §2). Более гранулярна,
/// чем TariffCategory: различает квартиры/нежилые vs парковки/кладовки, аренду, целевые, иное.
/// Бакет задолженности (TariffCategory) выводится из IncomeCategory при агрегации
/// (RESIDENT_DUES/PARKING_DUES → MAINTENANCE; CAPITAL_REPAIR_CONTRIBUTION → CAPITAL_REPAIR;
/// TARGETED_* → TARGETED; RENTAL/OTHER — вне бакетов долга).
enum IncomeCategory {
  RESIDENT_DUES // 6.1 текущие взносы квартир/нежилых на управление
  PARKING_STORAGE_DUES // 6.2 взносы за парковки/кладовки
  CAPITAL_REPAIR_CONTRIBUTION // 6.3 накопительные взносы на кап.ремонт
  RENTAL_INCOME // 6.4 плата за аренду общего имущества
  TARGETED_RESIDENT // 6.5 целевые взносы квартир/нежилых
  TARGETED_PARKING // 6.6 целевые взносы парковок/кладовок
  OTHER_INCOME // 6.7 иные поступления
}

/// Факт оплаты (поступление). Статья — ОБЯЗАТЕЛЬНОЕ поле, председатель указывает вручную
/// при вводе (Q-032 закрыт): один реальный платёж на несколько статей = несколько строк Payment.
/// Никакой авто-аллокации в MVP.
model Payment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId          String         @map("osi_id") @db.Uuid
  accountId      String         @map("account_id") @db.Uuid
  amount         Decimal        @db.Decimal(12, 2)
  paidAt         DateTime       @map("paid_at")
  method         String? // ручной ввод / импорт (Q-012) / демо-оплата онлайн (payments-online.md)
  /// Метка симулятора эквайринга (payments-online.md, ADR-0010) — только для онлайн-демо-оплат,
  /// null для ручного ввода председателем. Информационная, НЕ используется для идемпотентности
  /// (та обеспечивается пересчётом долга на сервере при каждом вызове).
  gatewayRef     String?        @map("gateway_ref")
  bankRef        String?        @map("bank_ref")
  incomeCategory IncomeCategory @map("income_category")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([accountId])
  @@map("payment")
  @@unique([osiId, bankRef])
}

// ---- Банковские счета и расходы (report-spec.md, bank-import.md) — REQ-025/026 ----

enum BankAccountType {
  CURRENT // текущий — управление/содержание
  SAVINGS // сберегательный — накопления на кап.ремонт (расходование только по решению собрания)
}

model BankAccount {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId          String          @map("osi_id") @db.Uuid
  buildingId     String          @map("building_id") @db.Uuid
  type           BankAccountType
  bankName       String          @map("bank_name")
  accountNumber  String          @map("account_number") // IBAN
  currentBalance Decimal?        @map("current_balance") @db.Decimal(14, 2)
  updatedAt      DateTime        @updatedAt @map("updated_at")

  building   Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  expenses   Expense[]
  statements BankStatement[]

  @@index([osiId])
  @@index([buildingId])
  @@map("bank_account")
}

/// Импортированная выписка (Kaspi Pay и т.п., bank-import.md) — источник остатков (блок 1–2
/// отчёта) и сверки итогов (правило 3 в bank-import.md: "Всего списано" = Σ Expense до тиына).
model BankStatement {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId          String    @map("osi_id") @db.Uuid
  bankAccountId  String    @map("bank_account_id") @db.Uuid
  periodFrom     DateTime  @map("period_from")
  periodTo       DateTime  @map("period_to")
  openingBalance Decimal   @map("opening_balance") @db.Decimal(14, 2)
  closingBalance Decimal   @map("closing_balance") @db.Decimal(14, 2)
  totalIncome    Decimal   @map("total_income") @db.Decimal(14, 2)
  totalExpense   Decimal   @map("total_expense") @db.Decimal(14, 2)
  sourceFileUrl  String?   @map("source_file_url") // оригинал PDF — первичный документ
  reconciledAt   DateTime? @map("reconciled_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([bankAccountId])
  @@map("bank_statement")
}

/// Категория расхода — строки 7.1.1–7.6 формы отчёта (report-spec.md §2, Приложение 3 № 163).
enum ExpenseCategory {
  LABOR_ACCOUNTING // 7.1.1 оплата труда — бухучёт/отчётность
  LABOR_MANAGEMENT // 7.1.2 оплата труда — управление объектом
  BUDGET_PAYMENTS // 7.1.3 обязательные платежи в бюджет
  BANK_SERVICES // 7.1.4 банковские услуги
  CASH_SERVICE // 7.1.5 расчётно-кассовое обслуживание
  OFFICE // 7.1.6 содержание офиса
  SERVICE_CONTRACT // 7.2.1 услуги субъектам сервисной деятельности (см. counterparty)
  CURRENT_REPAIR // 7.3 текущий ремонт общего имущества
  UTILITIES // 7.4 коммунальные услуги на содержание общего имущества
  HOUSEHOLD // 7.5 хозяйственные расходы
  CAPITAL_REPAIR // 7.6 капитальный ремонт (только со сберегательного счёта, по решению собрания)
}

model Counterparty {
  id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId String  @map("osi_id") @db.Uuid
  name  String
  bin   String? // БИН/ИИН контрагента
  type  String? // ИП/ТОО/НАО/физлицо

  expenses Expense[]

  @@index([osiId])
  @@map("counterparty")
}

/// Расход ОСИ (блок 7 отчёта). withheldTax/contractRef — для выплат физлицам по ДГП
/// (bank-import.md правило 2: сумма + удержанный ИПН 10%, ссылка на договор ГПХ).
model Expense {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId              String          @map("osi_id") @db.Uuid
  buildingId         String          @map("building_id") @db.Uuid
  bankAccountId      String          @map("bank_account_id") @db.Uuid
  expenseCategory    ExpenseCategory @map("expense_category")
  date               DateTime
  amount             Decimal         @db.Decimal(14, 2)
  counterpartyId     String?         @map("counterparty_id") @db.Uuid
  purpose            String?
  withheldTax        Decimal?        @map("withheld_tax") @db.Decimal(14, 2)
  contractRef        String?         @map("contract_ref") // ДГП/договор/акт
  isInternalTransfer Boolean         @default(false) @map("is_internal_transfer") // перевод между своими счетами — не доход/расход
  actUrl             String?         @map("act_url") // подтверждающий акт (7.2.1)
  bankRef            String?         @map("bank_ref")

  building     Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id])
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id])

  @@index([osiId])
  @@index([buildingId])
  @@index([bankAccountId])
  @@map("expense")
  @@unique([osiId, bankRef])
}

