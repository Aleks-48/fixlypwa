  PUBLISHED
}

/// Публичное представление (жителям) исключает ПДн — report-spec.md §2а: ИИН, телефоны,
/// реквизиты, ФИО рядового персонала скрыты (заменяются агрегатом «ФОТ персонала»).
/// Разделение internal/public реализуется на уровне сериализации при отдаче отчёта, не схемой.
model Report {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
