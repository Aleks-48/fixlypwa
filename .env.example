# ─────────────────────────────────────────────────────────────────────────────
# Пример окружения. Скопируй в .env и подставь реальные секреты (.env вне репо, NFR-053).
# Значения ниже — безопасные локальные дефолты для `docker compose up` на своей машине.
# Для продакшна замени ВСЕ пароли на сильные секреты.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (суперпользователь; используется миграциями и как владелец БД) ──
POSTGRES_DB=fixlypwa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Пароли ролей приложения (ADR-0006) ──
# app_login — обычная роль, ПОД RLS; из неё работает весь рантайм приложения.
# app_superadmin — роль BYPASSRLS для явных кросс-тенантных админ-путей (обращаться как с
# суперпользователем). Роли создаёт RLS-миграция с плейсхолдером, db-bootstrap ставит эти пароли.
APP_DB_PASSWORD=app_pass
APP_SUPERADMIN_PASSWORD=superadmin_pass

# ── Подключения Prisma ──
# DATABASE_URL — рантайм приложения. ОБЯЗАТЕЛЬНО роль app_login (не postgres!): суперпользователь
# обходит RLS, и изоляция тенантов перестанет работать.
#   • локальный dev без PgBouncer  → прямое подключение app_login к Postgres (RLS всё равно действует):
#       postgresql://app_login:app_pass@localhost:5544/fixlypwa?schema=public
#   • полный стек через PgBouncer   → добавь pgbouncer=true (transaction pooling):
#       postgresql://app_login:app_pass@localhost:6432/fixlypwa?pgbouncer=true&schema=public
DATABASE_URL="postgresql://app_login:app_pass@localhost:5544/fixlypwa?schema=public"

# DIRECT_URL — прямое подключение суперпользователя для `prisma migrate` (в обход PgBouncer).
DIRECT_URL="postgresql://postgres:postgres@localhost:5544/fixlypwa?schema=public"

# ── Auth / сессии (ADR-0005) ──
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# console — dev-заглушка (OTP в лог сервера); sms — реальный шлюз (Q-030, при интеграции).
SMS_PROVIDER=console
# Эхо OTP-кода в API-ответе/UI (подсказка «код для входа»). Секьюрный дефолт — 0.
# Локально для демо можно поставить 1. ⚠️ В ПРОДЕ ТОЛЬКО 0: с 1 любой может запросить
# код чужого номера и увидеть его в ответе (захват аккаунта). Без эха код виден в логе app.
OTP_DEV_ECHO=0

# ── Web Push (срез 7, опционально) ──
# Без ключей push отключён (in-app центр уведомлений работает всегда).
# Генерация пары ключей: npx web-push generate-vapid-keys
# ⚠️ Payload push не должен содержать ПДн (REQ-105) — это обеспечивает код, ключи только транспорт.
WEB_PUSH_EMAIL=
WEB_PUSH_PRIVATE_KEY=
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=

# ── Гос-интеграции (опционально; см. docs/specs/gov-integrations.md) ──
# Aitu Passport (Digital ID): партнёрские ключи выдаёт BTS Digital по договору.
# Без ключей кнопка «Войти через Aitu» скрыта; OAuth-адаптер готов (src/lib/gov/aitu.ts).
AITU_CLIENT_ID=
AITU_CLIENT_SECRET=
AITU_BASE_URL=
# Smart Bridge (sb.egov.kz): сервис-ключ после договора; без него — заглушка NOT_CONFIGURED.
SMARTBRIDGE_SERVICE_KEY=
