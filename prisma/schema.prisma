// Единый источник модели данных проекта (CLAUDE.md).
// Домен описан на языке предметной области в docs/specs/domain-model.md — этот файл его
// техническая реализация. Мультитенантность — Postgres RLS по osiId (ADR-0006, паттерн
// подтверждён спайком spikes/rls-prisma/). RLS-политики добавляются raw-SQL поверх миграции,
// сгенерированной из этой схемы (см. prisma/migrations/.../migration.sql).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================================================
// IDENTITY — вне RLS (bootstrapping, ADR-0006 ревизия): сессия → пользователь → его Osi
// =====================================================================================

model Osi {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  bin          String?   @unique @db.VarChar(12)
  address      String?
  registeredAt DateTime? @map("registered_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  roles     UserOsiRole[]
  buildings Building[]

  @@map("osi")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone        String?  @unique
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  isSuperadmin Boolean  @default(false) @map("is_superadmin")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions          Session[]
  roles             UserOsiRole[]
  occupant          Occupant?
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  master            Master?
  votes             Vote[]

  @@map("users")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

model OtpChallenge {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  requestIp  String?   @map("request_ip")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@index([createdAt])
  @@map("otp_challenge")
}

model Session {
  id          String   @id
  userId      String   @map("user_id") @db.Uuid
  activeOsiId String?  @map("active_osi_id") @db.Uuid
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum Role {
  SUPERADMIN
  CHAIRMAN
  RESIDENT
}

model UserOsiRole {
  userId String @map("user_id") @db.Uuid
  osiId  String @map("osi_id") @db.Uuid
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  osi  Osi  @relation(fields: [osiId], references: [id], onDelete: Cascade)

  @@id([userId, osiId])
  @@map("user_osi_role")
}

enum MasterStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

model Master {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String            @unique @map("user_id") @db.Uuid
  fullName   String            @map("full_name")
  city       String
  categories RequestCategory[]
  bio        String?
  status     MasterStatus      @default(PENDING)
  createdAt  DateTime          @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers  MarketOffer[]
  reviews MasterReview[]

  @@index([city, status])
  @@map("master")
}

// =====================================================================================
// TENANT — под RLS. Каждая модель несёт osiId (ADR-0006).
// =====================================================================================

model Building {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId           String @map("osi_id") @db.Uuid
  address         String
  city            String @default("Кокшетау")
  apartmentsCount Int?   @map("apartments_count")
  builtYear       Int?   @map("built_year")

  osi           Osi            @relation(fields: [osiId], references: [id])
  apartments    Apartment[]
  tariffs       Tariff[]
  reports       Report[]
  subscription  Subscription?
  bankAccounts  BankAccount[]
  expenses      Expense[]
  announcements Announcement[]
  requests      Request[]
  infoItems     InfoItem[]
  polls         Poll[]
  meetings      Meeting[]
  documents     Document[]

  @@index([osiId])
  @@map("building")
}

model Apartment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId      String   @map("osi_id") @db.Uuid
  buildingId String   @map("building_id") @db.Uuid
  number     String
  area       Decimal? @db.Decimal(8, 2)

  building  Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  account   Account?
  owners    Owner[]
  occupants Occupant[]
  requests  Request[]

  @@index([osiId])
  @@index([buildingId])
  @@map("apartment")
}

model Account {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId         String  @map("osi_id") @db.Uuid
  apartmentId   String  @unique @map("apartment_id") @db.Uuid
  accountNumber String? @map("account_number")

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  charges   Charge[]
  payments  Payment[]

  @@index([osiId])
  @@map("account")
}

model Owner {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId          String   @map("osi_id") @db.Uuid
  apartmentId    String   @map("apartment_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  fullName       String   @map("full_name")
  phone          String?
  iin            String?
  ownershipShare Decimal? @map("ownership_share") @db.Decimal(5, 4)

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([apartmentId])
  @@map("owner")
}

model Occupant {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId       String @map("osi_id") @db.Uuid
  apartmentId String @map("apartment_id") @db.Uuid
  userId      String @unique @map("user_id") @db.Uuid
  fullName    String @map("full_name")
  phone       String

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([apartmentId])
  @@map("occupant")
}

enum TariffCategory {
  MAINTENANCE
  TARGETED
  CAPITAL_REPAIR
}

enum RateType {
  PER_SQM
  FIXED
}

model Tariff {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId      String         @map("osi_id") @db.Uuid
  buildingId String         @map("building_id") @db.Uuid
  category   TariffCategory
  rateType   RateType       @map("rate_type")
  rate       Decimal        @db.Decimal(12, 2)
  periodFrom DateTime       @map("period_from")
  periodTo   DateTime?      @map("period_to")

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  charges  Charge[]

  @@index([osiId])
  @@index([buildingId])
  @@map("tariff")
}

enum ChargeStatus {
  OPEN
  PARTIALLY_PAID
  PAID
}

model Charge {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId     String       @map("osi_id") @db.Uuid
  accountId String       @map("account_id") @db.Uuid
  tariffId  String       @map("tariff_id") @db.Uuid
  period    DateTime
  amount    Decimal      @db.Decimal(12, 2)
  dueDate   DateTime     @map("due_date")
  status    ChargeStatus @default(OPEN)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tariff  Tariff  @relation(fields: [tariffId], references: [id])

  @@index([osiId])
  @@index([accountId])
  @@map("charge")
}

enum IncomeCategory {
  RESIDENT_DUES
  PARKING_STORAGE_DUES
  CAPITAL_REPAIR_CONTRIBUTION
  RENTAL_INCOME
  TARGETED_RESIDENT
  TARGETED_PARKING
  OTHER_INCOME
}

model Payment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId          String         @map("osi_id") @db.Uuid
  accountId      String         @map("account_id") @db.Uuid
  amount         Decimal        @db.Decimal(12, 2)
  paidAt         DateTime       @map("paid_at")
  method         String?
  gatewayRef     String?        @map("gateway_ref")
  incomeCategory IncomeCategory @map("income_category")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([accountId])
  @@map("payment")
}

enum BankAccountType {
  CURRENT
  SAVINGS
}

model BankAccount {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId          String          @map("osi_id") @db.Uuid
  buildingId     String          @map("building_id") @db.Uuid
  type           BankAccountType
  bankName       String          @map("bank_name")
  accountNumber  String          @map("account_number")
  currentBalance Decimal?        @map("current_balance") @db.Decimal(14, 2)
  updatedAt      DateTime        @updatedAt @map("updated_at")

  building   Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  expenses   Expense[]
  statements BankStatement[]

  @@index([osiId])
  @@index([buildingId])
  @@map("bank_account")
}

model BankStatement {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId          String    @map("osi_id") @db.Uuid
  bankAccountId  String    @map("bank_account_id") @db.Uuid
  periodFrom     DateTime  @map("period_from")
  periodTo       DateTime  @map("period_to")
  openingBalance Decimal   @map("opening_balance") @db.Decimal(14, 2)
  closingBalance Decimal   @map("closing_balance") @db.Decimal(14, 2)
  totalIncome    Decimal   @map("total_income") @db.Decimal(14, 2)
  totalExpense   Decimal   @map("total_expense") @db.Decimal(14, 2)
  sourceFileUrl  String?   @map("source_file_url")
  reconciledAt   DateTime? @map("reconciled_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([bankAccountId])
  @@map("bank_statement")
}

enum ExpenseCategory {
  LABOR_ACCOUNTING
  LABOR_MANAGEMENT
  BUDGET_PAYMENTS
  BANK_SERVICES
  CASH_SERVICE
  OFFICE
  SERVICE_CONTRACT
  CURRENT_REPAIR
  UTILITIES
  HOUSEHOLD
  CAPITAL_REPAIR
}

model Counterparty {
  id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId String  @map("osi_id") @db.Uuid
  name  String
  bin   String?
  type  String?

  expenses Expense[]

  @@index([osiId])
  @@map("counterparty")
}

model Expense {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId              String          @map("osi_id") @db.Uuid
  buildingId         String          @map("building_id") @db.Uuid
  bankAccountId      String          @map("bank_account_id") @db.Uuid
  expenseCategory    ExpenseCategory @map("expense_category")
  date               DateTime
  amount             Decimal         @db.Decimal(14, 2)
  counterpartyId     String?         @map("counterparty_id") @db.Uuid
  purpose            String?
  withheldTax        Decimal?        @map("withheld_tax") @db.Decimal(14, 2)
  contractRef        String?         @map("contract_ref")
  isInternalTransfer Boolean         @default(false) @map("is_internal_transfer")
  actUrl             String?         @map("act_url")

  building     Building      @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount   @relation(fields: [bankAccountId], references: [id])
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id])

  @@index([osiId])
  @@index([buildingId])
  @@index([bankAccountId])
  @@map("expense")
}

enum ReportType {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum ReportStatus {
  DRAFT
  GENERATED
  PUBLISHED
}

model Report {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId            String       @map("osi_id") @db.Uuid
  buildingId       String       @map("building_id") @db.Uuid
  type             ReportType   @default(MONTHLY)
  periodFrom       DateTime     @map("period_from")
  periodTo         DateTime     @map("period_to")
  status           ReportStatus @default(DRAFT)
  generatedAt      DateTime?    @map("generated_at")
  publishedAt      DateTime?    @map("published_at")
  accountantName   String?      @map("accountant_name")
  chairmanName     String?      @map("chairman_name")
  houseCouncilName String?      @map("house_council_name")
  fileUrl          String?      @map("file_url")
  data             Json?

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([buildingId])
  @@map("report")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId       String             @map("osi_id") @db.Uuid
  buildingId  String             @unique @map("building_id") @db.Uuid
  plan        String?
  status      SubscriptionStatus @default(TRIAL)
  periodStart DateTime           @map("period_start")
  periodEnd   DateTime?          @map("period_end")

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@map("subscription")
}

enum AuditEntityType {
  CHARGE
  PAYMENT
  TARIFF
  EXPENSE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId       String          @map("osi_id") @db.Uuid
  entityType  AuditEntityType @map("entity_type")
  entityId    String          @map("entity_id") @db.Uuid
  action      AuditAction
  diff        Json?
  actorUserId String          @map("actor_user_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([osiId])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model AdminAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  entityId    String   @map("entity_id")
  diff        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([action, entityId])
  @@map("admin_audit_log")
}

// =====================================================================================
// КОММУНИКАЦИЯ
// =====================================================================================

enum AnnouncementScope {
  BUILDING
  ENTRANCE
  APARTMENT
}

model Announcement {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId        String            @map("osi_id") @db.Uuid
  buildingId   String            @map("building_id") @db.Uuid
  authorUserId String            @map("author_user_id") @db.Uuid
  title        String
  body         String
  scope        AnnouncementScope @default(BUILDING)
  targetIds    String[]          @map("target_ids")
  isPinned     Boolean           @default(false) @map("is_pinned")
  createdAt    DateTime          @default(now()) @map("created_at")

  building Building           @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  reads    AnnouncementRead[]

  @@index([osiId])
  @@index([buildingId])
  @@map("announcement")
}

model AnnouncementRead {
  osiId          String   @map("osi_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([osiId])
  @@map("announcement_read")
}

enum RequestCategory {
  PLUMBING
  ELEVATOR
  CLEANING
  ELECTRICITY
  OTHER
}

enum RequestStatus {
  RECEIVED
  IN_PROGRESS
  RESOLVED
}

model OsiMaster {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId           String            @map("osi_id") @db.Uuid
  fullName        String            @map("full_name")
  phone           String
  whatsapp        String?
  telegram        String?
  specialties     RequestCategory[]
  experienceYears Int               @default(1) @map("experience_years")
  photoUrl        String?           @map("photo_url")
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")

  requests Request[]

  @@index([osiId])
  @@map("osi_master")
}

model MasterReview {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId     String   @map("osi_id") @db.Uuid
  requestId String   @unique @map("request_id") @db.Uuid
  masterId  String   @map("master_id") @db.Uuid
  rating    Int
  comment   String?
  photoUrls String[] @map("photo_urls")
  createdAt DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  master  Master  @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([masterId])
  @@map("master_review")
}

model Request {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId        String          @map("osi_id") @db.Uuid
  buildingId   String          @map("building_id") @db.Uuid
  apartmentId  String?         @map("apartment_id") @db.Uuid
  authorUserId String          @map("author_user_id") @db.Uuid
  category     RequestCategory
  text         String
  photoUrls    String[]        @map("photo_urls")
  status       RequestStatus   @default(RECEIVED)
  masterId     String?         @map("master_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  building      Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  apartment     Apartment?       @relation(fields: [apartmentId], references: [id])
  master        OsiMaster?       @relation(fields: [masterId], references: [id], onDelete: SetNull)
  messages      RequestMessage[]
  marketListing MarketListing?
  review        MasterReview?

  @@index([osiId])
  @@index([buildingId])
  @@index([status])
  @@index([masterId])
  @@map("request")
}

model RequestMessage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId        String   @map("osi_id") @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  text         String
  createdAt    DateTime @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([requestId])
  @@map("request_message")
}

enum MarketListingStatus {
  PUBLISHED
  TAKEN
  CLOSED
}

model MarketListing {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId         String              @map("osi_id") @db.Uuid
  requestId     String              @unique @map("request_id") @db.Uuid
  city          String
  category      RequestCategory
  title         String
  description   String
  photoUrls     String[]            @map("photo_urls")
  buildingLabel String              @map("building_label")
  status        MarketListingStatus @default(PUBLISHED)
  publishedAt   DateTime            @default(now()) @map("published_at")
  closedAt      DateTime?           @map("closed_at")

  request Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  offers  MarketOffer[]

  @@index([osiId])
  @@index([city, status])
  @@map("market_listing")
}

enum MarketOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model MarketOffer {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId     String            @map("osi_id") @db.Uuid
  listingId String            @map("listing_id") @db.Uuid
  masterId  String            @map("master_id") @db.Uuid
  message   String
  price     Decimal?          @db.Decimal(12, 2)
  status    MarketOfferStatus @default(OFFERED)
  createdAt DateTime          @default(now()) @map("created_at")

  listing MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  master  Master        @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([listingId, masterId])
  @@index([osiId])
  @@index([listingId])
  @@index([masterId])
  @@map("market_offer")
}

enum InfoItemType {
  TRASH_SCHEDULE
  EMERGENCY_CONTACTS
  PAYMENT_DETAILS
  CHAIRMAN_CONTACTS
  OTHER
}

model InfoItem {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId      String       @map("osi_id") @db.Uuid
  buildingId String       @map("building_id") @db.Uuid
  type       InfoItemType
  title      String
  content    String

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([buildingId])
  @@map("info_item")
}

enum NotificationType {
  ANNOUNCEMENT
  REQUEST_CREATED
  REQUEST_STATUS
  REQUEST_MESSAGE
}

model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId      String           @map("osi_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String
  body       String
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id") @db.Uuid
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([userId, readAt])
  @@map("notification")
}

enum MeetingStatus {
  DRAFT
  IN_PROGRESS
  CLOSED
}

model Meeting {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId             String        @map("osi_id") @db.Uuid
  buildingId        String        @map("building_id") @db.Uuid
  agenda            String
  quorumRequirement String?       @map("quorum_requirement")
  status            MeetingStatus @default(DRAFT)
  protocolUrl       String?       @map("protocol_url")

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([osiId])
  @@index([buildingId])
  @@map("meeting")
}

model TelegramLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @unique
  chatId    String   @map("chat_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("telegram_link")
}

// =====================================================================================
// ГОЛОСОВАНИЯ И ОПРОСЫ
// =====================================================================================

enum PollType {
  INFORMATIONAL
  LEGALLY_BINDING
}

enum QuorumType {
  BY_AREA
  BY_APARTMENT
}

enum AuthMethod {
  AITU_PASSPORT
  EDS_NCALAYER
  SMS_OTP
  TELEGRAM_OTP
  DRAWN_SIGNATURE
}

model Poll {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId           String     @map("osi_id") @db.Uuid
  buildingId      String     @map("building_id") @db.Uuid
  title           String
  description     String?    @db.Text
  type            PollType   @default(INFORMATIONAL)
  quorumType      QuorumType @default(BY_AREA) @map("quorum_type")
  quorumThreshold Float      @default(50.0) @map("quorum_threshold")

  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isClosed  Boolean  @default(false) @map("is_closed")

  totalBuildingArea Float @map("total_building_area")
  totalApartments   Int   @map("total_apartments")

  building  Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     Vote[]
  documents Document[]   // <--- ДОБАВЬ ЭТУ СТРОЧКУ

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([osiId])
  @@index([buildingId])
  @@map("poll")
}

model PollOption {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId  String @map("osi_id") @db.Uuid
  pollId String @map("poll_id") @db.Uuid
  text   String

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([osiId])
  @@map("poll_option")
}

model Vote {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId       String  @map("osi_id") @db.Uuid
  pollId      String  @map("poll_id") @db.Uuid
  optionId    String  @map("option_id") @db.Uuid
  apartmentId String  @map("apartment_id") @db.Uuid
  userId      String? @map("user_id") @db.Uuid

  voterIin     String     @map("voter_iin")
  voterName    String     @map("voter_name")
  squareMeters Float      @map("square_meters")
  authMethod   AuthMethod @map("auth_method")

  signatureHash String  @map("signature_hash")
  signatureUrl  String? @map("signature_url")
  ipAddress     String? @map("ip_address")

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([pollId, apartmentId])
  @@index([osiId])
  @@index([pollId])
  @@index([userId])
  @@map("vote")
}

// =====================================================================================
// ДОКУМЕНТЫ
// =====================================================================================

enum DocumentCategory {
  PROTOCOL
  ESTIMATE
  REPORT
  OTHER
}

model Document {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  osiId       String           @map("osi_id") @db.Uuid
  buildingId  String           @map("building_id") @db.Uuid
  pollId      String?          @map("poll_id") @db.Uuid
  title       String
  category    DocumentCategory @default(OTHER)
  description String?
  fileUrl     String           @map("file_url")
  fileType    String?          @map("file_type")
  isPublic    Boolean          @default(true) @map("is_public")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  poll     Poll?    @relation(fields: [pollId], references: [id], onDelete: SetNull)

  @@index([osiId])
  @@index([buildingId])
  @@map("document")
}