# Копия для локальной разработки — сохранить как .env (не коммитится, см. .gitignore).

# ── Бэкенд fixlypwa (ADR-0011/ADR-0012, срез 21) ──
# Десктоп/iOS-симулятор: localhost. Android-эмулятор: http://10.0.2.2:3000 (эмулятор видит
# хост-машину через этот адрес, не localhost). Физическое устройство: IP машины в локальной сети.
API_BASE_URL=http://localhost:3000

# Username Telegram-бота (без @) — постоянная ссылка t.me/<username> на экранах входа/
# регистрации (не секрет, публичен по своей природе).
TELEGRAM_BOT_USERNAME=fixlyosibot

# ── YOLO-сканер дефектов (срез 31, опционально — без него сканер не работает) ──
YOLO_API_URL=
YOLO_TIMEOUT_SECONDS=20
YOLO_CONFIDENCE_THRESHOLD=0.4
YOLO_MAX_DETECTIONS=10
